{
  "name": "agy-statusblocks",
  "version": "0.1.2",
  "description": "Opinionated, adaptive block-based status line for Antigravity CLI (agy) with bin-packing layout, rate limit tracking, and live agent telemetry",
  "type": "module",
  "bin": {
    "agy-statusblocks": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "postinstall.cjs"
  ],
  "scripts": {
    "prepare": "npm run build",
    "postinstall": "node postinstall.cjs",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "preview": "node dist/cli.js preview"
  },
  "keywords": [
    "antigravity",
    "agy",
    "gemini",
    "statusline",
    "status-bar",
    "terminal",
    "cli",
    "ansi",
    "box-drawing",
    "rate-limit",
    "bin-packing",
    "layout"
  ],
  "homepage": "https://github.com/okanerturan/agy-statusblocks#readme",
  "bugs": {
    "url": "https://github.com/okanerturan/agy-statusblocks/issues"
  },
  "author": "Okan Turan",
  "repository": {
    "type": "git",
    "url": "https://github.com/okanerturan/agy-statusblocks"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
